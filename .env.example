# ---- Supabase (required) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Output sink selection ----
# Choices: supabase | gsheets   (default: supabase)
SINK=supabase

# ---- Google Sheets (optional) ----
GOOGLE_SHEETS_DOC_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json

# ---- Bluesky (optional, for crawler) ----
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# ---- Mastodon (optional, for crawler) ----
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# ---- Reddit (optional, for crawler) ----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=food-help-crawler/0.1 by yourname

# ---- YouTube (optional, for crawler) ----
YOUTUBE_API_KEY=

# ---- Geocoding (crawler) ----
GEOCODER_PROVIDER=nominatim
GOOGLE_GEOCODING_API_KEY=

